---
import BaseLayout from '../../../components/BaseLayout.astro'
import '../../../assets/css/demo.css'
---

<BaseLayout title="Paradimg playground" path="/paradimg/playground/" bodyClass="demo-page" mainClass="playground-layout" showHeader={false}>
	<header class="playground-header"><hgroup><h1><a href="/paradimg/">Paradimg</a></h1><h2>playground</h2></hgroup><nav><ul><li><a role="button" href="/paradimg/">Back</a></li><li><button id="reset" type="button">Reset</button></li><li><button id="fullscreen" type="button">Full Screen</button></li></ul></nav></header>
	<section class="playground-display"><div class="preview-stage" id="stage"><img id="preview" src="/paradimg-demo.svg" alt="A colourful abstract gradient for testing Paradimg effects." /></div><div class="code-preview"><div class="code-preview-header"><strong>Code</strong><button id="copy" type="button">Copy</button></div><pre><code id="code"></code></pre></div></section>
	<section class="playground-controls"><form><details open><summary>Effects</summary><label><span>Ordered dither</span><select id="dither"><option value="">none</option><option value="dither">default</option><option value="dither=2x2,4c">2×2 / 4 colours</option><option value="dither=4x4,4c" selected>4×4 / 4 colours</option><option value="dither=8x8,8c">8×8 / 8 colours</option><option value="dither=8x8,bw">8×8 monochrome</option></select></label><label class="checkbox-control"><input id="half" type="checkbox" /><span><code>half</code></span></label><label class="checkbox-control"><input id="bw" type="checkbox" /><span><code>bw</code></span></label></details><details open><summary>Adjustments</summary><label><span><code>brightness</code></span><input id="brightness" type="number" step="0.05" value="1" /></label><label><span><code>contrast</code></span><input id="contrast" type="number" step="0.05" value="1" /></label></details></form></section>
	<script>
		// @ts-nocheck
		import { processImages } from 'paradimg'
		const image = document.querySelector('#preview'); const code = document.querySelector('#code'); const stage = document.querySelector('#stage')
		const controls = ['dither', 'half', 'bw', 'brightness', 'contrast'].map(id => document.querySelector(`#${id}`))
		const render = async () => { const flags = []; if (document.querySelector('#half').checked) flags.push('half'); if (document.querySelector('#bw').checked) flags.push('bw'); const brightness = document.querySelector('#brightness').value; const contrast = document.querySelector('#contrast').value; if (brightness !== '1') flags.push(`brightness=${brightness}`); if (contrast !== '1') flags.push(`contrast=${contrast}`); const dither = document.querySelector('#dither').value; if (dither) flags.push(dither); const src = `/paradimg-demo.svg${flags.length ? `#?${flags.join('&')}` : ''}`; image.removeAttribute('data-image-processor-original-src'); image.removeAttribute('data-image-processor-processed-src'); image.removeAttribute('width'); image.removeAttribute('height'); image.src = src; code.textContent = `<img src="${src}" alt="" />`; await processImages({ selector: '#preview' }) }; controls.forEach(control => control.addEventListener('input', render)); document.querySelector('#reset').addEventListener('click', () => { document.querySelector('#dither').value = 'dither=4x4,4c'; document.querySelector('#half').checked = false; document.querySelector('#bw').checked = false; document.querySelector('#brightness').value = '1'; document.querySelector('#contrast').value = '1'; render() }); document.querySelector('#fullscreen').addEventListener('click', () => stage.requestFullscreen()); document.querySelector('#copy').addEventListener('click', () => navigator.clipboard.writeText(code.textContent)); render()
	</script>
</BaseLayout>
