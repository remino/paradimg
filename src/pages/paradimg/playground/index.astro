---
import BaseLayout from '../../../components/BaseLayout.astro'
import '../../../assets/css/demo.css'
---

<BaseLayout
	title="Paradimg Playground"
	path="/paradimg/playground/"
	bodyClass="demo-page"
	mainClass="playground-layout"
	showHeader={false}>
	<header class="playground-header">
		<hgroup>
			<h1><a href="/paradimg/">Paradimg</a></h1><h2>playground</h2>
		</hgroup><nav>
			<ul>
				<li><a role="button" href="/paradimg/">Back</a></li><li>
					<button id="reset" type="button">Reset</button>
				</li><li><button id="fullscreen" type="button">Full Screen</button></li>
			</ul>
		</nav>
	</header>
	<section class="playground-display">
		<div class="preview-stage" id="stage">
			<img
				id="preview"
				src="/paradimg-demo.svg"
				alt="A colourful abstract gradient for testing Paradimg effects."
			/>
		</div><div class="code-preview">
			<div class="code-preview-header">
				<strong>Code</strong><button id="copy" type="button">Copy</button>
			</div><code-viewer id="code"></code-viewer>
		</div>
	</section>
	<section class="playground-controls">
		<form>
			<details open>
				<summary>Effects</summary><select
					id="effects"
					size="6"
					aria-label="Effects stack"></select><div class="effect-actions">
					<button id="move-up" type="button" disabled>Move Up</button><button
						id="move-down"
						type="button"
						disabled>Move Down</button
					><button id="delete-effect" type="button" disabled>Delete</button>
				</div>
			</details><details open>
				<summary>Effect Properties</summary><select
					id="effect-to-add"
					aria-label="Effect to add"
					><option value="dither">Ordered dither</option><option value="bw"
						>Black and white</option
					><option value="brightness">Brightness</option><option
						value="contrast">Contrast</option
					><option value="half">Scale to half</option><option value="double"
						>Scale to double</option
					></select
				><div id="effect-options"></div><div class="effect-actions">
					<button id="update-effect" type="button" hidden>Update</button>
					<button id="add-effect" type="button">Add</button>
				</div>
			</details>
		</form>
	</section>
	<Fragment slot="scripts">
		<script src="../../../assets/js/playground.js"></script>
	</Fragment>
</BaseLayout>
